NEXT_PUBLIC_TOPOSAIC_API_URL=http://127.0.0.1:8787
# Optional: overrides the OS cache directory used for downloaded map inputs.
# TOPOSAIC_CACHE_DIR=/path/to/toposaic-cache
# Optional: points place search at another Nominatim-compatible service.
# TOPOSAIC_GEOCODER_URL=https://nominatim.openstreetmap.org
# Optional: comma-separated browser origins allowed to call the local API.
# TOPOSAIC_ALLOWED_ORIGINS=https://studio.example.com
